# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Settings > API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Google Cloud Console > APIs e serviços > Credenciais > seu Client ID OAuth
# (o Client Secret NUNCA vai aqui — só no Supabase, como secret da Edge Function)
VITE_GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
